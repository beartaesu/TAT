Sort(
    AddColumns(
        If(
            IsBlank(cmb업체.Selected.CompanyKey),
            Filter(
                현장마스터,
                ID = -1
            ),
            Filter(
                현장마스터,
                업체명키 = cmb업체.Selected.CompanyKey
            )
        ),
        DisplayName,
        제목
    ),
    DisplayName,
    SortOrder.Ascending
)
