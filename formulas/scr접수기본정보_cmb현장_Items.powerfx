Sort(
    AddColumns(
        If(
            IsBlank(cmb업체.Selected),
            Filter(
                현장마스터,
                ID = -1
            ),
            Filter(
                현장마스터,
                업체명복사 = cmb업체.Selected.제목
            )
        ),
        DisplayName,
        제목
    ),
    DisplayName,
    SortOrder.Ascending
)
