With(
    {
        loc업체명: Trim(txt업체관리업체명.Text),
        loc업체명키: Lower(
            Substitute(
                Substitute(
                    Substitute(
                        Substitute(
                            Trim(txt업체관리업체명.Text),
                            " ",
                            ""
                        ),
                        "(주)",
                        ""
                    ),
                    "㈜",
                    ""
                ),
                "주식회사",
                ""
            )
        ),
        loc계산서업체ID: cmb업체관리기본계산서업체.Selected.ID,
        loc계산서업체명: cmb업체관리기본계산서업체.Selected.Value
    },
    If(
        IsBlank(loc업체명),
        Notify(
            "업체명을 입력해 주세요.",
            NotificationType.Warning
        ),
        IsBlank(loc업체명키),
        Notify(
            "법인 표기를 제외한 업체명을 입력해 주세요.",
            NotificationType.Warning
        ),
        IsBlank(loc계산서업체ID),
        Notify(
            "기본 계산서 업체를 선택해 주세요.",
            NotificationType.Warning
        ),
        ClearCollect(
            col업체관리동일업체현장,
            FirstN(
                Filter(
                    현장마스터,
                    업체명키 = loc업체명키
                ),
                2
            )
        );
        ClearCollect(
            col업체관리동일기본현장,
            FirstN(
                Filter(
                    현장마스터,
                    업체명키 = loc업체명키 &&
                    기본현장여부 = true
                ),
                2
            )
        );

        If(
            CountRows(col업체관리동일기본현장) > 1,
            Notify(
                "동일 업체의 기본 현장이 2건 이상 있습니다. 현장마스터를 확인해 주세요.",
                NotificationType.Error
            ),
            CountRows(col업체관리동일기본현장) = 0 &&
            CountRows(col업체관리동일업체현장) > 0,
            Notify(
                "같은 업체의 현장은 있지만 기본 현장이 없습니다. 저장하지 않고 현장마스터를 확인해 주세요.",
                NotificationType.Error
            ),
            CountRows(col업체관리동일기본현장) = 1 &&
            Coalesce(
                First(col업체관리동일기본현장).'계산서 업체 연결'.Id,
                0
            ) <> loc계산서업체ID,
            Notify(
                "기존 기본 현장의 계산서 업체가 현재 선택값과 다릅니다. 저장하지 않고 현장마스터를 확인해 주세요.",
                NotificationType.Error
            ),
            CountRows(col업체관리동일기본현장) = 1,
            Notify(
                "업체와 기본 현장이 이미 등록되어 있습니다.",
                NotificationType.Information
            ),
            IfError(
                Patch(
                    현장마스터,
                    Defaults(현장마스터),
                    {
                        제목: loc업체명,
                        업체명복사: loc업체명,
                        업체명키: loc업체명키,
                        기본현장여부: true,
                        '계산서 업체 연결': {
                            Id: loc계산서업체ID,
                            Value: loc계산서업체명
                        }
                    }
                );
                Refresh(현장마스터);
                Reset(txt업체관리업체명);
                Reset(cmb업체관리기본계산서업체);
                Notify(
                    "업체와 기본 현장을 저장했습니다.",
                    NotificationType.Success
                ),
                Notify(
                    "업체와 기본 현장 저장 중 오류가 발생했습니다: " & FirstError.Message,
                    NotificationType.Error
                )
            )
        )
    )
)
