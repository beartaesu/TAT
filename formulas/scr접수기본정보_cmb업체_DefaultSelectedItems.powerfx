With(
    {
        loc업체목록:
            ShowColumns(
                AddColumns(
                    Filter(
                        현장마스터,
                        기본현장여부 = true
                    ),
                    Value,
                    Text(업체명복사),
                    CompanyKey,
                    Text(업체명키)
                ),
                ID,
                Value,
                CompanyKey
            )
    },
    If(
        var완료접수수정모드 || var이어쓰기,
        With(
            {
                loc기존현장:
                    LookUp(
                        현장마스터,
                        ID = var저장헤더.'업체/현장'.Id
                    )
            },
            Filter(
                loc업체목록,
                CompanyKey = Text(loc기존현장.업체명키)
            )
        ),
        Filter(
            loc업체목록,
            ID = -1
        )
    )
)
